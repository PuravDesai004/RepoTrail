include README.md LICENSE CONTRIBUTING.md AGENTS.md pyproject.toml requirements-dev.lock
recursive-include docs *.md
recursive-include examples *.py *.json *.md
include scripts/build_skill.py
prune tests
prune evals
exclude scripts/live_smoke.py scripts/verify_skill.py scripts/verify_wheel.py
recursive-include skills *.md *.py *.yaml *.json *.txt *.whl
include downloads/repotrail-skill.zip downloads/repotrail-skill.zip.sha256
include skills/repotrail/LICENSE .gitattributes
include .github/workflows/ci.yml
global-exclude *.py[cod] __pycache__
