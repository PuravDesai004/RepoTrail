include README.md LICENSE pyproject.toml
include docs/agent-skill.md docs/ai.md docs/cli.md docs/limits.md docs/mcp.md docs/languages.md
prune examples
prune scripts
prune tests
prune evals
exclude AGENTS.md CONTRIBUTING.md requirements-dev.lock docs/architecture.md docs/status.md
recursive-include skills *.md *.py *.yaml *.json *.txt *.whl
include downloads/repotrail-skill.zip downloads/repotrail-skill.zip.sha256
include skills/repotrail/LICENSE .gitattributes
include .github/workflows/ci.yml
global-exclude *.py[cod] __pycache__
